{
  "name": "fastify-serverless-template",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "esbuild src/**/*.ts --outdir=dist/local && nodemon dist/local/server.js",
    "build": "esbuild src/index.ts --bundle --minify --platform=node --outdir=dist/lambda --external:'@aws-sdk/*'",
    "lint": "eslint src/**/*.ts",
    "format": "prettier src/**/*.{ts,tsx} --single-quote --write",
    "test": "tsc --noEmit && ENV=test jest --maxWorkers=2",
    "test:coverage": "tsc --noEmit && ENV=test jest --coverage",
    "prepare": "husky"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.0",
    "fastify": "^5.9.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^5.36.1",
    "@typescript-eslint/parser": "^5.36.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "ext": "ts,js,json",
    "watch": [
      "src/"
    ],
    "events": {
      "restart": "esbuild src/**/*.ts --outdir=dist/local"
    }
  }
}
