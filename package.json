{
  "type": "module",
  "scripts": {
    "dev": "esbuild src/**/*.ts --outdir=dist/local && nodemon dist/local/app.js",
    "build": "esbuild src/index.ts --bundle --minify --platform=node --outdir=dist/lambda --external:@aws-sdk",
    "lint": "eslint src/**/*.ts",
    "format": "prettier src/**/*.{ts,tsx} --single-quote --write",
    "test": "tsc && ENV=test jest --maxWorkers=2",
    "test:coverage": "tsc && ENV=test jest --coverage",
    "prepare": "husky"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "devDependencies": {
    "@fastify/aws-lambda": "^5.0.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^5.36.1",
    "@typescript-eslint/parser": "^5.36.1",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "fastify": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.0.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2"
  },
  "nodemonConfig": {
    "ext": "ts,js,json",
    "watch": [
      "src/"
    ],
    "events": {
      "restart": "esbuild --format=esm src/**/*.ts --outdir=dist"
    }
  }
}
