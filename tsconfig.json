{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "paths": {
      "#src/*": [
        "./*"
      ]
    }
  },
  "include": ["src", "specs", "jest.config.ts"]
}
